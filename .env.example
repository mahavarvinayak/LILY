# ---------------------------------------------------------------------------
# LILY — environment
# Copy to .env.local and fill in.
#
# Supabase is required for production: every screen reads real rows. With no
# Supabase keys the app only enters the demo workspace when DEMO_MODE=1 is set
# in a non-production environment.
# ---------------------------------------------------------------------------

# --- Supabase (Project Settings → API) — required ---------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose with NEXT_PUBLIC_. Used by the operator cockpit,
# OTP challenges and mailbox storage. Bypasses RLS, so only server code.
SUPABASE_SERVICE_ROLE_KEY=

# --- Encryption and shared secrets — required -------------------------------
# AES-256-GCM key for stored SMTP passwords AND the HMAC key for 6-digit
# sign-in codes. Rotating it invalidates stored mailboxes and pending codes.
# Generate with: openssl rand -base64 32
ENCRYPTION_SECRET=
# Bearer token required by /api/cron/daily-digest. Generate: openssl rand -hex 32
CRON_SECRET=
# Bearer token required by /api/mcp. Generate: openssl rand -hex 32
LILY_MCP_SECRET_KEY=

# --- AI providers (optional, but needed for AI drafts and the agent bar) ----
# Groq (console.groq.com/keys) — drafts leads + powers the agent bar
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Z.ai / Zhipu GLM (open.bigmodel.cn) — primary agent model, cascades to Groq
ZAI_API_KEY=
# Optional split keys; both fall back to ZAI_API_KEY
ZAI_API_KEY_FAST=
ZAI_API_KEY_HEAVY=
ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# --- Connectors (optional) --------------------------------------------------
# Composio (app.composio.dev) — Gmail / Outlook / Calendar OAuth
COMPOSIO_API_KEY=

# --- Email delivery (optional, but required for OTP sign-in and digests) ----
# Resend (resend.com/api-keys)
RESEND_API_KEY=
# Must be a verified domain or onboarding@resend.dev while testing
RESEND_FROM_EMAIL=LILY <outreach@yourdomain.com>

# --- Notifications (optional) ----------------------------------------------
# Slack incoming webhook — daily digest notifications
SLACK_WEBHOOK_URL=

# --- Runtime ---------------------------------------------------------------
# Canonical URL used in Slack buttons, OAuth redirects and auth redirects
NEXT_PUBLIC_APP_URL=https://lily-dusky.vercel.app
# Set to 1 to serve the in-memory demo workspace. Ignored in production.
DEMO_MODE=
